{
  "name": "@helix-x-rawla/client-sdk",
  "version": "0.1.0",
  "private": true,
  "description": "This application's API client. Generated from its own OpenAPI document, with the framework surface subtracted and re-exported from @helix-x/core-sdk.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "codegen": "helix-x-app-codegen",
    "generate": "pnpm codegen && pnpm build",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@helix-x/core-sdk": "0.0.1",
    "axios": "^1.7.9",
    "form-data": "^4.0.1"
  },
  "devDependencies": {
    "openapi-typescript-codegen": "^0.29.0",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0"
  }
}
