# React is a peer dependency supplied by the consuming app; do not pull a second
# copy into this package's node_modules, it would break hooks when linked.
legacy-peer-deps=true
@helix-x:registry="https://packages.allquill.com/repository/allquill-npm/"
always-auth=true
//packages.allquill.com/repository/allquill-npm/:_auth=${NPM_TOKEN}