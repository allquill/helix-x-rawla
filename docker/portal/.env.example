# Compose settings for docker-compose.yml. Copy to .env and edit.
# Every value is optional — the compose file carries the same defaults.

# ── Images ─────────────────────────────────────────────────────────────────
# Each image is <DOCKER_REGISTRY>/<*_IMAGE>:<*_TAG>, and each part is set on
# its own. Leave DOCKER_REGISTRY empty to run the images built locally with
# `pnpm docker:build`. A private registry needs `docker login <registry>` once.
DOCKER_REGISTRY=docker.allquill.com
# Repository names only — no registry, no tag.
# Tags match `TAG=<tag> pnpm docker:build:backend|frontend` (default: local).
BACKEND_IMAGE=helix-x-rawla-backend
BACKEND_TAG=local
FRONTEND_IMAGE=helix-x-rawla-frontend
FRONTEND_TAG=local

# ── Data ───────────────────────────────────────────────────────────────────
# Host folder, relative to this directory, bind-mounted into the backend. The
# database is <folder>/data/helix_x.db. Point it elsewhere to start from a fresh
# database or reuse another one. Gitignored at the default location.
DOCKER_VOLUME_FOLDER=./docker-volume

# Start from the sample database bundled in the backend image (21 members, five
# chapters). Only applies when the data folder has no database yet — an
# existing one is never touched; delete the folder to re-seed. Demo use only:
# it signs in as admin@example.com / Password!1, which is published.
SEED_SAMPLE_DB=false

# ── Network ────────────────────────────────────────────────────────────────
RAWLA_NETWORK=rawla-net

# ── Ports on the host ──────────────────────────────────────────────────────
# The portal (and its /api, proxied by nginx).
FRONTEND_PORT=8080
# The API directly, for /docs and debugging. Bound to localhost by default.
BACKEND_PORT=3001
BACKEND_BIND=127.0.0.1

# ── Backend config ─────────────────────────────────────────────────────────
# App settings and secrets, kept out of this file. Relative to this directory.
BACKEND_ENV_FILE=./backend.env
