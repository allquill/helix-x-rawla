# The Rawla Compose stack's ONE settings file. Copy to .env and edit.
#
#   cp .env.example .env
#
# It does two jobs at once:
#   · Compose reads it to fill in docker-compose.yml (images, ports, folders);
#   · the backend container receives all of it as its environment (app config
#     and secrets).
# .env is gitignored because it holds secrets. Every backend setting, with what
# it does, is in DEPLOY.md §9.2 (and apps/backend/.env.example).
#
# Compose interpolates this file: write a literal `$` in any value as `$$`.
# TRUST_PROXY is fixed by docker-compose.yml. DB_PATH defaults to /data/helix_x.db
# (a path inside the container, on the data folder below); leave it unset.

# ── Images ─────────────────────────────────────────────────────────────────
# Each image is <DOCKER_REGISTRY>/<*_IMAGE>:<*_TAG>, and each part is set on
# its own. Leave DOCKER_REGISTRY empty to run the images built locally with
# `pnpm docker:build`. A private registry needs `docker login <registry>` once.
DOCKER_REGISTRY=
# Repository names only — no registry, no tag.
# Tags match `TAG=<tag> pnpm docker:build:backend|frontend` (default: local).
BACKEND_IMAGE=helix-x-rawla-backend
BACKEND_TAG=local
FRONTEND_IMAGE=helix-x-rawla-frontend
FRONTEND_TAG=local

# ── Data folder ────────────────────────────────────────────────────────────
# Host folder, relative to this directory, bind-mounted into the backend. The
# SQLite database is <folder>/data/helix_x.db; the bundled postgres keeps its
# data in <folder>/postgres. Gitignored at the default location.
DOCKER_VOLUME_FOLDER=./docker-volume

# ── Network and host ports ─────────────────────────────────────────────────
RAWLA_NETWORK=rawla-net
# The portal (and its /api, proxied by nginx).
FRONTEND_PORT=8080
# The API directly, for /docs and debugging. Bound to localhost by default.
BACKEND_PORT=3001
BACKEND_BIND=127.0.0.1

# ── Database ───────────────────────────────────────────────────────────────
# Pick ONE of the three. Whichever it is, apply the numbered migrations by hand
# before the first start (apps/backend/migrations/README.md) — the backend
# never migrates and refuses a database that is behind.
#
# 1. SQLite (default): the file in DOCKER_VOLUME_FOLDER/data. Nothing else to set.
DB_TYPE=sqlite
#
# 2. The bundled postgres service, started by the profile:
# DB_TYPE=postgres
# COMPOSE_PROFILES=postgres
# POSTGRES_USER=rawla
# POSTGRES_PASSWORD=rawla
# POSTGRES_DB=rawla
# DATABASE_URL=postgres://rawla:rawla@postgres:5432/rawla
#
# 3. Your own Postgres (13+), no profile. From inside the container,
#    `localhost` is the container itself — a database published on your Mac's
#    port is reached as host.docker.internal:
# DB_TYPE=postgres
# DATABASE_URL=postgresql://USER:PASSWORD@host.docker.internal:5432/rawla_dev
#
# TLS: empty for a local server (SSL off — anything else fails with "The server
# does not support SSL connections"); `true` (verified) or `no-verify` for a
# managed provider.
DB_SSL=
# Keep false: the migrations own the schema. true rebuilds tables from entities.
DB_SYNCHRONIZE=false
DB_LOGGING=false

# ── App ────────────────────────────────────────────────────────────────────
# development lets the console mail and payment providers load, so the stack
# runs with no SMTP or Stripe account: emailed links appear at
# http://localhost:8080/api/dev/outbox and dues settle on a dev route. For a
# real deployment set production and configure MAIL_TRANSPORT (smtp|gmail) and
# PAYMENT_PROVIDER=stripe below — both console providers refuse production.
NODE_ENV=development

# Required — change these. Long random values, different from each other.
# JWT_SECRET is NOT enforced: left unset, the framework silently falls back to
# a public default.   openssl rand -base64 48   (then write any $ as $$)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
OAUTH_JWT_SECRET=change-me-to-a-different-long-random-string

# Both are the frontend's origin: the portal and its /api share it. Keep the
# port in step with FRONTEND_PORT above.
PORTAL_PUBLIC_URL=http://localhost:8080
API_PUBLIC_URL=http://localhost:8080

# ── Contact form ───────────────────────────────────────────────────────────
# Where Contact Us messages go; comma-separate several. The app will not boot
# without it.
CONTACT_TO_EMAIL=membership@example.org

# ── Documents ──────────────────────────────────────────────────────────────
# Signs the short-lived view/download links. Required, at least 32 characters;
# the app will not boot without it. The links are built on API_PUBLIC_URL above.
DOCUMENTS_SIGNING_SECRET=change-me-to-a-third-long-random-string
# Files are stored in DOCKER_VOLUME_FOLDER/data/documents. For S3 or MinIO
# instead, see the DOCUMENTS_* keys in apps/backend/.env.example.
# Stored files end in their real name by default; `opaque` stores ids only.
# Naming, not encryption. New uploads only.
# DOCUMENTS_STORAGE_NAMING=opaque
# DOCUMENTS_STORAGE_DRIVER=s3
# DOCUMENTS_S3_BUCKET=
# Raising this past 50 also needs client_max_body_size in the frontend's nginx.
# DOCUMENTS_MAX_FILE_SIZE_MB=50

# ── Mail ───────────────────────────────────────────────────────────────────
MAIL_TRANSPORT=console
MAIL_FROM=Rajputana Rawla <no-reply@localhost>
# MAIL_REPLY_TO=
# MAIL_TRANSPORT=gmail
# GMAIL_USER=
# GMAIL_APP_PASSWORD=
# MAIL_TRANSPORT=smtp
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=

# ── Membership dues ────────────────────────────────────────────────────────
PAYMENT_PROVIDER=console
# PAYMENT_PROVIDER=stripe
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
