# Backend config for the compose stack. Copy to backend.env and edit.
# backend.env is gitignored — it holds secrets. Every setting, with what it
# does, is in DEPLOY.md §9.2 (and apps/backend/.env.example).
#
# DB_PATH, TRUST_PROXY and SEED_SAMPLE_DB are set by docker-compose.yml
# (SEED_SAMPLE_DB from .env); do not set them here.

# development lets the console mail and payment providers load, so the stack
# runs with no SMTP or Stripe account: emailed links appear at
# http://localhost:8080/api/dev/outbox and dues settle on a dev route. For a
# real deployment set production and configure MAIL_TRANSPORT (smtp|gmail) and
# PAYMENT_PROVIDER=stripe below — both console providers refuse production.
NODE_ENV=development

# ── Required — change these ────────────────────────────────────────────────
# Long random values, different from each other. JWT_SECRET is NOT enforced:
# left unset, the framework silently falls back to a public default.
#   openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
OAUTH_JWT_SECRET=change-me-to-a-different-long-random-string
# Where Contact Us messages go; comma-separate several. The app will not boot
# without it.
CONTACT_TO_EMAIL=membership@example.org

# ── Public URLs ────────────────────────────────────────────────────────────
# Both are the frontend's origin: the portal and its /api share it.
# Keep the port in step with FRONTEND_PORT in .env.
PORTAL_PUBLIC_URL=http://localhost:8080
API_PUBLIC_URL=http://localhost:8080

# ── Database ───────────────────────────────────────────────────────────────
# Migrations own the schema; the entrypoint runs pending ones on every start.
RUN_MIGRATIONS=true
DB_SYNCHRONIZE=false
DB_LOGGING=false

# ── Mail ───────────────────────────────────────────────────────────────────
MAIL_TRANSPORT=console
MAIL_FROM=Rajputana Rawla <no-reply@localhost>
# MAIL_REPLY_TO=
# MAIL_TRANSPORT=gmail
# GMAIL_USER=
# GMAIL_APP_PASSWORD=
# MAIL_TRANSPORT=smtp
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=

# ── Membership dues ────────────────────────────────────────────────────────
PAYMENT_PROVIDER=console
# PAYMENT_PROVIDER=stripe
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
