# Vite mode file: read by `vite build --mode development`.
# Committed on purpose — every VITE_* value is inlined into the bundle
# and therefore public by definition. Never put a secret here.

# EMPTY on purpose: the generated SDK's paths already begin with /api, so an
# empty OpenAPI.BASE yields same-origin requests that the frontend image's
# nginx proxies to BACKEND_UPSTREAM.
VITE_API_SERVER=http://localhost:3001
VITE_APP_NAME=Rajputana Rawla
VITE_APP_LOGO=/extension/rra-crest-mark.svg
VITE_FEATURE_OAUTH=true
VITE_FEATURE_REPORTS=true
VITE_FEATURE_HOME=true
VITE_FEATURE_REGISTRATION=true
VITE_FEATURE_MEMBERS=true
VITE_FEATURE_MEMBERSHIP_ADMIN=true
VITE_FEATURE_CHAPTERS=true
# Dev Tools
VITE_FEATURE_DEVTOOLS=true