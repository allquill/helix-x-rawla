# Rawla portal — static SPA plus a same-origin /api proxy.
#
# Rendered at container start by the nginx image's envsubst step, which only
# substitutes variables that are set in the environment — so nginx's own
# $uri, $host and friends pass through untouched.
#
#   PORT                    listen port: 80 by default, or whatever the platform sets
#   BACKEND_UPSTREAM        where /api goes, e.g. http://backend:3001 (no path);
#                           a bare host:port gets http:// added (15-backend-upstream.envsh)
#   NGINX_LOCAL_RESOLVERS   filled in by the image from /etc/resolv.conf
#
# The bundle is built with an empty VITE_API_SERVER, so the app calls /api on
# its own origin and this proxy forwards it: no CORS, and no backend URL baked
# into the JavaScript.

server {
    listen ${PORT};
    listen [::]:${PORT};
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Resolve the backend per request rather than once at startup, so the
    # container starts (and serves the app) even before the backend's name
    # exists — nginx would otherwise refuse to boot and crash-loop.
    resolver ${NGINX_LOCAL_RESOLVERS} valid=30s ipv6=off;

    location /api/ {
        set $backend "${BACKEND_UPSTREAM}";
        # A variable with no URI part passes the original request URI through
        # unchanged: /api/health → ${BACKEND_UPSTREAM}/api/health.
        proxy_pass $backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        # The backend's per-IP limits read this when TRUST_PROXY is set.
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
        # Stripe webhooks and uploads: do not cap the body below the backend's own limit.
        client_max_body_size 10m;
    }

    # Documents (DocumentsModule). Uploads (POST /api/documents, PUT
    # /api/documents/:id/content) go up to DOCUMENTS_MAX_FILE_SIZE_MB, 50 MB by
    # default — raise this with it. Streamed straight through, not spooled here.
    location /api/documents {
        set $backend "${BACKEND_UPSTREAM}";
        proxy_pass $backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_request_buffering off;
        proxy_read_timeout 300s;
        client_max_body_size 55m;
    }

    # Vite fingerprints everything under /assets, so it can be cached forever.
    location /assets/ {
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, max-age=31536000, immutable";
        access_log off;
    }

    # Client-side routes (/join, /members/me, …) all serve the app shell.
    # index.html itself is never cached, so a deploy is picked up on reload.
    location / {
        try_files $uri $uri/ /index.html;
    }

    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;
}
