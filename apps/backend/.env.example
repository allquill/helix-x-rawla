NODE_ENV=development
PORT=3001

# Database (SQLite)
DB_PATH=data/helix_x.db
# Create/update tables from the TypeORM entities on every boot.
# Defaults to true outside production, false in production. Set to false to
# manage the schema with migrations instead
# (pnpm --filter @helix-x/demo-backend migration:run).
DB_SYNCHRONIZE=false

# JWT
JWT_SECRET=dev-secret-change-me-in-production
JWT_EXPIRES_IN=7d

# Secret for signing OAuth tokens, should be different from JWT_SECRET
OAUTH_JWT_SECRET=a-long-random-secret-different-from-JWT_SECRET

# LangGraph dev server (agents-server runs on :2024)
# ── Transactional email ────────────────────────────────────────────────────
# console: no network — messages are captured at GET /api/dev/outbox so
#          verification and reset links stay clickable locally. Dev default;
#          refuses to load when NODE_ENV=production.
# gmail:   nodemailer via Google. GMAIL_APP_PASSWORD must be an App Password
#          (https://myaccount.google.com/apppasswords), not the account password.
# smtp:    any other SMTP server.
MAIL_TRANSPORT=console
MAIL_FROM=Rajputana Rawla <no-reply@localhost>
MAIL_REPLY_TO=

GMAIL_USER=
GMAIL_APP_PASSWORD=

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# Base URL the emailed credential links point at (verification, password setup, reset).
PORTAL_PUBLIC_URL=http://localhost:5173
