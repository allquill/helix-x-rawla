NODE_ENV=development
PORT=3001

# Database driver: sqlite (default) or postgres. The schema comes from the
# numbered SQL files in apps/backend/migrations/<driver>/, applied by hand — the
# app never migrates, and refuses to start on a database that is behind.
DB_TYPE=sqlite
# postgres only: connection URL, and DB_SSL. Leave DB_SSL EMPTY for a local
# Postgres (Homebrew, Postgres.app, Docker), which has SSL off. `true` (verified
# TLS) and `no-verify` (encrypted, certificate not checked) are for managed
# providers; both REQUIRE TLS, so against a local server they fail with
# "The server does not support SSL connections".
DATABASE_URL=
DB_SSL=

# Database (SQLite)
DB_PATH=data/helix_x.db
# Apply pending migrations at startup (what `pnpm db:migrate` does) before the
# schema check. Off unless exactly `true`: the app then refuses a database that
# is behind and lists the files to apply. SQLite keeps a <DB_PATH>.pre-migrate-*
# copy first; Postgres serialises concurrent instances with an advisory lock.
DB_AUTO_MIGRATE=false
# Build tables from the TypeORM entities on boot. Off unless exactly `true`:
# the numbered SQL migrations own the schema. Never enable it in production.
DB_SYNCHRONIZE=false
# SQL logging. true | false | all, or a comma-separated list of TypeORM levels
# (query,error,schema,warn,info,log). Unset follows NODE_ENV: on under
# `development`, off everywhere else. `true` is TypeORM's own meaning — query
# and error only; use `all` to also see schema and startup chatter. An
# unrecognised value warns at startup and falls back rather than failing to boot.
# `pnpm db:schema:log` reads this too (only `all` and `true`).
DB_LOGGING=false

# JWT
JWT_SECRET=dev-secret-change-me-in-production
JWT_EXPIRES_IN=7d

# Secret for signing OAuth tokens, should be different from JWT_SECRET
OAUTH_JWT_SECRET=a-long-random-secret-different-from-JWT_SECRET

# LangGraph dev server (agents-server runs on :2024)
# ── Transactional email ────────────────────────────────────────────────────
# console: no network — messages are captured at GET /api/dev/outbox so
#          verification and reset links stay clickable locally. Dev default;
#          refuses to load when NODE_ENV=production.
# gmail:   nodemailer via Google. GMAIL_APP_PASSWORD must be an App Password
#          (https://myaccount.google.com/apppasswords), not the account password.
# smtp:    any other SMTP server.
MAIL_TRANSPORT=console
MAIL_FROM=Rajputana Rawla <no-reply@localhost>
MAIL_REPLY_TO=

GMAIL_USER=
GMAIL_APP_PASSWORD=

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# Base URL the emailed credential links point at (verification, password setup, reset).
PORTAL_PUBLIC_URL=http://localhost:5173

# ── Membership dues payment ────────────────────────────────────────────────
# console: takes no money. The checkout URL is a backend dev route
#          (GET /api/dev/payments/:ref/complete) that settles on the spot, so the
#          whole join → pay → activate flow runs locally. Dev default; refuses to
#          load when NODE_ENV=production.
# stripe:  Stripe Checkout. The payment gate closes only when the signed webhook
#          arrives at POST /api/payments/stripe/webhook — locally, forward it with
#          `stripe listen --forward-to localhost:3001/api/payments/stripe/webhook`.
PAYMENT_PROVIDER=console
# Required when PAYMENT_PROVIDER=stripe; the app refuses to boot without them.
STRIPE_SECRET_KEY=
# The whsec_… secret printed by `stripe listen`, or the endpoint's signing secret
# in the Stripe dashboard. Without it every webhook fails verification and dues
# never settle.
STRIPE_WEBHOOK_SECRET=
# Optional. Send Stripe API calls here instead of api.stripe.com — set to
# http://localhost:12111 to use docker/stripe-mock (which accepts any sk_test_
# key). Unset in real test/live mode; refused when NODE_ENV=production.
STRIPE_API_BASE=
# Public origin of this API, used to build the console provider's checkout URL
# and the documents view/download links. Defaults to http://localhost:$PORT.
API_PUBLIC_URL=

# ── Contact Us form (POST /api/contact) ────────────────────────────────────
# Required: the app refuses to boot without it. Where public contact-form
# messages are delivered; comma-separate several addresses.
CONTACT_TO_EMAIL=membership@example.org
# Prepended to each message's subject line.
CONTACT_SUBJECT_PREFIX=[Contact]
# Submissions allowed per client IP per hour.
CONTACT_RATE_LIMIT_PER_HOUR=5

# ── Documents (DocumentsModule, /api/documents) ────────────────────────────
# Where file bytes live: local (default) or s3 (any S3-compatible store).
DOCUMENTS_STORAGE_DRIVER=local
# DOCUMENTS_STORAGE_DRIVER=local: a directory, relative to apps/backend.
DOCUMENTS_LOCAL_ROOT=data/documents
# How stored files are named. Files are NOT encrypted either way — this is naming only.
#   readable (default): …/<documentId>/v1/Quarterly report.pdf — an admin can
#            recognise and open files straight from the disk or bucket.
#   opaque:  …/<documentId>/v1 — ids only, no filename or extension.
# Applies to new uploads and new versions; existing files keep the name they have.
DOCUMENTS_STORAGE_NAMING=readable
# Required, at least 32 characters: signs the short-lived view/download links.
# The app refuses to boot without it.
DOCUMENTS_SIGNING_SECRET=dev-documents-link-secret-change-me-0000000
# Upload limit, in MB. Behind the frontend image's nginx, raise
# client_max_body_size on /api/documents with it or uploads fail with 413.
DOCUMENTS_MAX_FILE_SIZE_MB=50
# Comma-separated MIME types to accept, exact or wildcard (image/*,application/pdf).
# Empty accepts anything; active types (HTML, SVG, …) are still only ever downloaded.
DOCUMENTS_ALLOWED_MIME_TYPES=
# Lifetime of a view/download link, in seconds.
DOCUMENTS_LINK_TTL_SECONDS=300
# Absolute API root the links are built on. Empty: API_PUBLIC_URL + /api when
# that is set, else taken from the request (http://localhost:3001/api locally).
# Wrong behind a proxy and every preview and download link is dead.
DOCUMENTS_PUBLIC_BASE_URL=

# DOCUMENTS_STORAGE_DRIVER=s3. Leave the key pair empty to use the AWS default
# credential chain. For MinIO: DOCUMENTS_S3_ENDPOINT=http://localhost:9000 and
# DOCUMENTS_S3_FORCE_PATH_STYLE=true.
DOCUMENTS_S3_BUCKET=
DOCUMENTS_S3_REGION=
DOCUMENTS_S3_PREFIX=
DOCUMENTS_S3_ENDPOINT=
DOCUMENTS_S3_FORCE_PATH_STYLE=false
DOCUMENTS_S3_ACCESS_KEY_ID=
DOCUMENTS_S3_SECRET_ACCESS_KEY=

# ── Reverse proxy ──────────────────────────────────────────────────────────
# Trust X-Forwarded-For from this many proxy hops (Express `trust proxy`).
# Set to 1 behind the frontend image's nginx, or the per-IP limits above see
# every visitor as the proxy. Leave empty when the API is exposed directly.
TRUST_PROXY=

# Scheduled jobs: the timer that emails event invitations and reminders
# (EventsModule). Set to false on an instance that should only serve requests,
# or to keep a local run quiet. Two instances may both leave it on — a message
# is claimed in the database before it is sent, so it goes out once. Without a
# running instance that has it on, published events are never announced.
JOBS_ENABLED=true
