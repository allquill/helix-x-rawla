# Ignore rules for apps/backend/Dockerfile.
#
# Named `Dockerfile.dockerignore` on purpose: BuildKit reads it instead of a
# `.dockerignore` at the context root, so the frontend and backend images keep
# separate allow-lists. Paths are relative to this repo's root, the context.
#
# Allow-list: exclude everything, then re-include only what the backend image
# needs. Anything new has to be added here deliberately — which is how local
# .env secrets, the registry credentials and the SQLite database stay out of the
# image. (Registry auth arrives as a BuildKit secret instead.)

*

# Workspace manifests: the lockfile resolves every importer. .pnpmfile.cjs is
# a no-op in the image, but the lockfile records its checksum.
!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml
!.pnpmfile.cjs
# Names the registry only; the credential arrives as a BuildKit secret.
!.npmrc
!scripts/check-lockfile.mjs
!tsconfig.base.json
!apps/frontend/package.json
!packages/client-sdk/package.json

# The backend itself.
!apps/backend

# …minus local state, build output and anything that is not source.
apps/backend/node_modules
apps/backend/dist
apps/backend/data
apps/backend/coverage
apps/backend/.turbo
apps/backend/.env
apps/backend/.env.*
apps/backend/**/*.tsbuildinfo
apps/backend/**/*.spec.ts
**/.DS_Store
